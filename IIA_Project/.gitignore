# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example
sources/*/laptop.env

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Generated CSV/data files
*.csv

# Generated reports
reports/*.pdf

# Test/cache/coverage
.pytest_cache/
.coverage
htmlcov/
.coverage.*
.pyre/
.mypy_cache/
.ruff_cache/

# IDEs / editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
# Phase 2 workstream A: ~2200 rendered plate images are regenerated by
# scripts/make_plate_images.py (deterministic for a given --seed), so they are not committed.
# The manifest and the benchmark CSV are, despite the blanket *.csv rule above.
data/plate_images/*
!data/plate_images/manifest.csv
!data/match_benchmark.csv
